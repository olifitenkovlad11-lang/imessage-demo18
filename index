#accessGate .gate-card{width:min(360px,100%);text-align:center}
#accessGate h1{font-size:28px;margin:0 0 10px;font-weight:700}
#accessGate p{color:#6b6b70;margin:0 0 22px}
#accessGate input{box-sizing:border-box;width:100%;height:52px;border:1px solid #c7c7cc;border-radius:14px;background:#fff;text-align:center;font-size:20px;letter-spacing:5px;outline:none}
#accessGate button{width:100%;height:52px;margin-top:12px;border:0;border-radius:14px;background:#007aff;color:#fff;font-size:17px;font-weight:600}
#accessGate .gate-error{min-height:22px;margin-top:12px;color:#ff3b30;font-size:14px}
