#appContentLocked{display:none}
</style>

<div id="accessGate" aria-modal="true" role="dialog">
  <div class="gate-card">
    <h1>Код доступа</h1>
    <p>Введите код, который вы получили от владельца приложения.</p>
    <input id="accessCodeInput" inputmode="numeric" autocomplete="one-time-code"
           maxlength="32" placeholder="Код доступа" aria-label="Код доступа">
    <button id="accessCodeButton">Открыть приложение</button>
    <div id="accessGateError" class="gate-error"></div>
  </div>
</div>
<script id="access-gate-script">
(() => {
  const ACCESS_API_URL = "https://eretsmhafzgqmwlwdwdd.supabase.co/functions/v1/verify-access-code";
  const SAVED_CODE_KEY = "protected_app_saved_access_code";

  const gate = document.getElementById("accessGate");
  const input = document.getElementById("accessCodeInput");
  const button = document.getElementById("accessCodeButton");
  const error = document.getElementById("accessGateError");

  let currentAccessCode = "";
  let accessCheckTimer = null;
  let accessCheckInFlight = false;

  function showError(message) {
    error.textContent = message;
  }

  function getDeviceId() {
    const key = "protected_app_device_id";
    let id = localStorage.getItem(key);

    if (!id) {
      id = (crypto && crypto.randomUUID)
        ? crypto.randomUUID()
        : "device-" + Date.now() + "-" + Math.random().toString(36).slice(2);

      localStorage.setItem(key, id);
    }

    return id;
  }

  async function verifyCode(code) {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 4500);

    try {
      const response = await fetch(ACCESS_API_URL, {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({
          code,
          device_id: getDeviceId()
        }),
        signal: controller.signal,
        cache: "no-store"
      });

      let data = {};
      try { data = await response.json(); } catch (_) {}

      if (!response.ok || !data.allowed) {
        const e = new Error(data.message || "INVALID_CODE");
        e.code = data.message || "INVALID_CODE";
        throw e;
      }

      return data;
    } finally {
      clearTimeout(timeout);
    }
  }

  function saveAccessForDevice(code) {
    // Persistent on this browser/device so the code is not requested on every launch.
    localStorage.setItem(SAVED_CODE_KEY, code);
    localStorage.setItem("app_access_granted", "1");
  }

  function clearSavedAccess() {
    localStorage.removeItem(SAVED_CODE_KEY);
    localStorage.removeItem("app_access_granted");
  }

  function startLiveChecking() {
    if (accessCheckTimer) clearTimeout(accessCheckTimer);

    const tick = async () => {
      if (!currentAccessCode) return;

      if (!document.hidden && !accessCheckInFlight) {
        accessCheckInFlight = true;

        try {
          await verifyCode(currentAccessCode);
        } catch (e) {
          lockApp(e);
          accessCheckInFlight = false;
          return;
        } finally {
          accessCheckInFlight = false;
        }
      }

      if (currentAccessCode) {
        accessCheckTimer = setTimeout(tick, 5000);
      }
    };

    accessCheckTimer = setTimeout(tick, 5000);
  }

  function lockApp(e) {
    if (accessCheckTimer) clearTimeout(accessCheckTimer);

    accessCheckTimer = null;
    currentAccessCode = "";
    accessCheckInFlight = false;

    // If the server revoked/expired the code, forget it on this device.
    clearSavedAccess();

    gate.style.display = "flex";
    input.value = "";
    button.textContent = "Открыть приложение";

    if (e?.code === "DEVICE_LIMIT_REACHED") {
      showError("Лимит устройств для этого кода исчерпан.");
    } else if (e?.code === "CODE_EXPIRED") {
      showError("Срок действия кода истёк.");
    } else if (e?.code === "INVALID_CODE") {
      showError("Код доступа больше не действителен.");
    } else {
      showError("Доступ был заблокирован владельцем приложения.");
    }
  }

  async function openWithCode(code, persist) {
    await verifyCode(code);

    currentAccessCode = code;

    if (persist) {
      saveAccessForDevice(code);
    }

    gate.style.display = "none";
    startLiveChecking();
  }

  async function submit() {
    const code = input.value.trim();
    showError("");

    if (!code) {
      showError("Введите код доступа.");
      return;
    }

    gate.classList.add("loading");
    button.textContent = "Проверка…";

    try {
      // First successful manual entry is remembered on this device.
      await openWithCode(code, true);
    } catch (e) {
      if (e.name === "AbortError") {
        showError("Проверка заняла слишком много времени. Попробуйте ещё раз.");
      } else if (e.code === "DEVICE_LIMIT_REACHED") {
        showError("Лимит устройств для этого кода исчерпан.");
      } else if (e.code === "CODE_EXPIRED") {
        showError("Срок действия кода истёк.");
      } else if (e.code === "INVALID_CODE") {
        showError("Неверный код доступа.");
      } else if (e.code === "INVALID_DEVICE") {
        showError("Не удалось определить устройство.");
      } else {
        showError("Не удалось проверить код. Попробуйте ещё раз.");
      }
    } finally {
      gate.classList.remove("loading");
      button.textContent = "Открыть приложение";
    }
  }

  async function restoreSavedAccess() {
    const savedCode = localStorage.getItem(SAVED_CODE_KEY);

    if (!savedCode) {
      gate.style.display = "flex";
      return;
    }

    gate.classList.add("loading");
    button.textContent = "Проверка сохранённого доступа…";
    showError("");

    try {
      // Do not blindly trust localStorage: validate the saved code with the server.
      await openWithCode(savedCode, false);
    } catch (e) {
      clearSavedAccess();
      currentAccessCode = "";
      gate.style.display = "flex";
      input.value = "";

      if (e.name === "AbortError") {
        showError("Не удалось подтвердить сохранённый доступ. Введите код ещё раз.");
      } else if (e.code === "CODE_EXPIRED") {
        showError("Срок действия сохранённого кода истёк. Введите новый код.");
      } else if (e.code === "INVALID_CODE") {
        showError("Сохранённый код больше не действителен. Введите новый код.");
      } else {
        showError("Не удалось подтвердить доступ. Введите код ещё раз.");
      }
    } finally {
      gate.classList.remove("loading");
      button.textContent = "Открыть приложение";
    }
  }

  button.addEventListener("click", submit);

  input.addEventListener("keydown", e => {
    if (e.key === "Enter") submit();
  });

  document.addEventListener("visibilitychange", async () => {
    if (document.hidden || !currentAccessCode || accessCheckInFlight) return;

    accessCheckInFlight = true;
    try {
      await verifyCode(currentAccessCode);
    } catch (e) {
      lockApp(e);
    } finally {
      accessCheckInFlight = false;
    }
  });

  // On every launch: if this device already has a remembered code,
  // validate it and enter without asking the user again.
  restoreSavedAccess();
})();
</script>

