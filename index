<script>
let scannerStream = null;
let scannerFacing = "environment";
let scannerTimer = null;
let scannerBusy = false;

async function openScanner(){
  const el = document.getElementById("scanner");
  const status = document.getElementById("scanStatus");

  // Do not display the camera UI until permission + stream are ready.
  el.classList.remove("open");
  el.setAttribute("aria-hidden","true");
  document.body.style.overflow="";

  if (!window.isSecureContext && location.hostname !== "localhost") {
    status.textContent = "Камера требует HTTPS. Откройте приложение через защищённое соединение.";
    setTimeout(()=>{ if(status) status.textContent=""; }, 4500);
    return;
  }

  status.textContent = "Запрашиваем доступ к камере…";

  try {
    await startScannerCamera();

    // Stream is ready — only now reveal the scanner interface.
    el.classList.add("open");
    el.setAttribute("aria-hidden","false");
    document.body.style.overflow="hidden";

    status.textContent = "Ищем 4 цифры";
  } catch(e) {
    console.error("Scanner camera error:", e);

    if (scannerStream) {
      scannerStream.getTracks().forEach(t=>t.stop());
      scannerStream = null;
    }

    const name = e && e.name ? e.name : "";

    if (name === "NotAllowedError" || name === "PermissionDeniedError" || name === "SecurityError") {
      status.textContent = "Доступ к камере запрещён. Разрешите камеру для этого сайта в настройках iPhone.";
    } else if (name === "NotFoundError") {
      status.textContent = "Камера не найдена.";
    } else if (name === "NotReadableError") {
      status.textContent = "Камера занята другим приложением.";
    } else if (name === "OverconstrainedError") {
      status.textContent = "Не удалось выбрать камеру. Попробуйте ещё раз.";
    } else if (name === "AbortError") {
      status.textContent = "Запрос камеры был прерван. Попробуйте ещё раз.";
    } else {
      status.textContent = "Не удалось получить доступ к камере.";
    }

    setTimeout(()=>{ if(status) status.textContent=""; }, 5000);
  }
}

function closeScanner(){
  if(scannerTimer) clearInterval(scannerTimer);
  scannerTimer=null;

  if(scannerStream){
    scannerStream.getTracks().forEach(t=>t.stop());
    scannerStream=null;
  }

  const v=document.getElementById("scannerVideo");
  if(v){
    v.pause();
    v.srcObject=null;
  }

  const el=document.getElementById("scanner");
  el.classList.remove("open");
  el.setAttribute("aria-hidden","true");
  document.body.style.overflow="";
}

async function startScannerCamera(){
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    throw new Error("getUserMedia unavailable");
  }

  if(scannerStream){
    scannerStream.getTracks().forEach(t=>t.stop());
    scannerStream=null;
  }

  // iOS Safari/PWA is more reliable with a simple facingMode request.
  // Avoid `exact` on the first request because it can prevent the permission
  // flow on some iPhone/Safari versions.
  const constraintsList = [
    {video:{facingMode:"environment", width:{ideal:1920}, height:{ideal:1080}}, audio:false},
    {video:{facingMode:{ideal:"environment"}, width:{ideal:1280}, height:{ideal:720}}, audio:false},
    {video:true, audio:false}
  ];

  let stream = null;
  let lastError = null;

  for(const constraints of constraintsList){
    try{
      stream = await navigator.mediaDevices.getUserMedia(constraints);
      if(stream) break;
    }catch(e){
      lastError = e;

      // Permission/security errors must not be hidden by another request.
      if(e.name === "NotAllowedError" ||
         e.name === "PermissionDeniedError" ||
         e.name === "SecurityError"){
        throw e;
      }
    }
  }

  if(!stream) throw lastError || new Error("camera unavailable");

  scannerStream = stream;

  const v = document.getElementById("scannerVideo");
  v.muted = true;
  v.autoplay = true;
  v.playsInline = true;
  v.setAttribute("playsinline","");
  v.setAttribute("webkit-playsinline","");
  v.srcObject = stream;

  // Wait until iPhone has actual video dimensions before showing UI.
  await new Promise((resolve,reject)=>{
    let done=false;
    const finish=()=>{
      if(done) return;
      done=true;
      clearTimeout(timer);
      v.removeEventListener("loadedmetadata",finish);
      resolve();
    };
    const timer=setTimeout(finish,2500);
    v.addEventListener("loadedmetadata",finish,{once:true});
  });

  try{
    await v.play();
  }catch(e){
    // Some iOS versions resolve play only after metadata; retry once.
    await new Promise(r=>setTimeout(r,100));
    await v.play();
  }

  const track = stream.getVideoTracks()[0];
  if(track && track.readyState !== "live"){
    throw new Error("camera track is not live");
  }
}

async function flipScannerCamera(){
  scannerFacing = scannerFacing==="environment" ? "user" : "environment";
  try{
    await startScannerCamera();
  }catch(e){
    document.getElementById("scanStatus").textContent="Не удалось переключить камеру";
  }
}

async function toggleScannerFlash(){
  const track=scannerStream && scannerStream.getVideoTracks()[0];
  if(!track) return;
  const caps=track.getCapabilities ? track.getCapabilities() : {};
  if(!caps.torch){
    document.getElementById("scanStatus").textContent="Вспышка недоступна";
    return;
  }
  const on=track.getSettings().torch===true;
  try{
    await track.applyConstraints({advanced:[{torch:!on}]});
  }catch(e){ console.warn(e); }
}


function extractCode(text){
  const normalized=(text||"")
    .replace(/[OoQqDd]/g,"0")
    .replace(/[IiLl|]/g,"1")
    .replace(/[Zz]/g,"2")
    .replace(/[Ss]/g,"5")
    .replace(/[Bb]/g,"8");

  const nums=(normalized.replace(/[^0-9]/g," ").match(/\b\d{4}\b/g)||[]);
  // 7000/7001 are chat IDs, not ticket/table codes.
  const valid=nums.filter(n=>n!=="7000"&&n!=="7001");
  return valid[0]||null;
}

function makeProcessedCanvas(sourceCanvas, mode=0){
  const scale=2;
  const c=document.createElement("canvas");
  c.width=sourceCanvas.width*scale;
  c.height=sourceCanvas.height*scale;
  const x=c.getContext("2d",{willReadFrequently:true});
  x.drawImage(sourceCanvas,0,0,c.width,c.height);

  const img=x.getImageData(0,0,c.width,c.height);
  const d=img.data;

  for(let i=0;i<d.length;i+=4){
    const y=0.299*d[i]+0.587*d[i+1]+0.114*d[i+2];

    if(mode===0){
      // High-contrast grayscale
      const v=Math.max(0,Math.min(255,(y-128)*1.8+128));
      d[i]=d[i+1]=d[i+2]=v;
    }else if(mode===1){
      // Binary threshold
      const v=y>145?255:0;
      d[i]=d[i+1]=d[i+2]=v;
    }else{
      // Dark-text-friendly threshold
      const v=y>175?255:(y<95?0:y);
      d[i]=d[i+1]=d[i+2]=v;
    }
  }
  x.putImageData(img,0,0);
  return c;
}

async function tryQR(video){
  if(!window.jsQR || !video.videoWidth) return null;

  const c=document.createElement("canvas");
  const max=1600;
  const w=Math.min(video.videoWidth,max);
  const h=Math.round(video.videoHeight*(w/video.videoWidth));
  c.width=w; c.height=h;

  const ctx=c.getContext("2d",{willReadFrequently:true});
  ctx.drawImage(video,0,0,w,h);
  const img=ctx.getImageData(0,0,w,h);

  const qr=jsQR(img.data,w,h,{
    inversionAttempts:"attemptBoth"
  });
  if(!qr || !qr.data) return null;

  return extractCode(qr.data) || (/\b\d{4}\b/.exec(qr.data||"")||[])[0] || null;
}


async function scanNow(){
  if(scannerBusy) return;

  const video=document.getElementById("scannerVideo");
  if(!video.videoWidth){
    document.getElementById("scanStatus").textContent="Камера ещё запускается…";
    return;
  }

  scannerBusy=true;
  const status=document.getElementById("scanStatus");
  status.textContent="Ищем цифры…";

  try{
    /*
      ВАЖНО:
      Нам нужен НЕ QR-код и НЕ текст "7000/7001".
      На табличке ищем именно крупную 4-значную цифру ВНИЗУ.
      Поэтому OCR получает несколько нижних областей кадра,
      а затем выбирает наиболее уверенный 4-значный результат.
    */

    const base=document.createElement("canvas");
    const targetW=Math.min(video.videoWidth,1920);
    const targetH=Math.round(video.videoHeight*(targetW/video.videoWidth));
    base.width=targetW;
    base.height=targetH;

    const bctx=base.getContext("2d",{willReadFrequently:true});
    bctx.drawImage(video,0,0,targetW,targetH);

    // Candidate regions: lower half / lower third / bottom-center.
    const regions=[
      {x:0.08,y:0.48,w:0.84,h:0.48},
      {x:0.12,y:0.58,w:0.76,h:0.36},
      {x:0.20,y:0.64,w:0.60,h:0.28},
      {x:0.05,y:0.40,w:0.90,h:0.58}
    ];

    const candidates=[];

    function cleanDigits(text){
      let s=(text||"")
        .replace(/[OoQqDd]/g,"0")
        .replace(/[IiLl|]/g,"1")
        .replace(/[Zz]/g,"2")
        .replace(/[Ss]/g,"5")
        .replace(/[Bb]/g,"8")
        .replace(/[^0-9]/g," ");

      // Search all 4-digit groups, allowing OCR to have inserted spaces.
      const compact=s.replace(/\s+/g," ");
      const matches=compact.match(/(?<!\d)\d{4}(?!\d)/g)||[];
      return matches.filter(v=>v!=="7000" && v!=="7001");
    }

    function cropRegion(r){
      const c=document.createElement("canvas");
      c.width=Math.max(1,Math.floor(targetW*r.w*2.2));
      c.height=Math.max(1,Math.floor(targetH*r.h*2.2));
      const cx=c.getContext("2d",{willReadFrequently:true});
      cx.imageSmoothingEnabled=false;
      cx.drawImage(
        base,
        Math.floor(targetW*r.x),
        Math.floor(targetH*r.y),
        Math.floor(targetW*r.w),
        Math.floor(targetH*r.h),
        0,0,c.width,c.height
      );
      return c;
    }

    function preprocess(source, mode){
      const c=document.createElement("canvas");
      c.width=source.width;
      c.height=source.height;
      const cx=c.getContext("2d",{willReadFrequently:true});
      cx.drawImage(source,0,0);

      const img=cx.getImageData(0,0,c.width,c.height);
      const d=img.data;

      for(let i=0;i<d.length;i+=4){
        const y=0.299*d[i]+0.587*d[i+1]+0.114*d[i+2];

        let v;
        if(mode===0){
          v=Math.max(0,Math.min(255,(y-128)*2.2+128));
        }else if(mode===1){
          v=y>155?255:0;
        }else{
          v=y>185?255:(y<105?0:y);
        }

        d[i]=d[i+1]=d[i+2]=v;
      }

      cx.putImageData(img,0,0);
      return c;
    }

    // OCR is intentionally restricted to digits.
    for(const region of regions){
      const crop=cropRegion(region);

      for(const mode of [0,1,2]){
        const processed=preprocess(crop,mode);

        const result=await Tesseract.recognize(
          processed,
          "eng",
          {
            logger:()=>{},
            config:{
              tessedit_char_whitelist:"0123456789",
              tessedit_pageseg_mode:"11"
            }
          }
        );

        const text=result.data?.text||"";
        const found=cleanDigits(text);

        for(const code of found){
          const confidence=Number(result.data?.confidence||0);

          // Prefer 4-digit values that are not the known SMS/chat prefixes.
          candidates.push({code,confidence});
        }
      }
    }

    if(candidates.length){
      // Highest confidence, with repeated detections getting a small bonus.
      const counts={};
      for(const c of candidates){
        counts[c.code]=(counts[c.code]||0)+1;
      }

      candidates.sort((a,b)=>{
        const scoreA=a.confidence + counts[a.code]*15;
        const scoreB=b.confidence + counts[b.code]*15;
        return scoreB-scoreA;
      });

      const found=candidates[0].code;

      const input=document.getElementById("codeInput");
      input.value=found;
      if(typeof validateInput==="function") validateInput();

      const resultEl=document.getElementById("scanResult");
      if(resultEl){
        resultEl.textContent=found;
        resultEl.classList.add("show");
      }

      status.textContent="Код найден";

      setTimeout(()=>{
        closeScanner();
        input.focus();
      },650);
    }else{
      status.textContent="Наведите камеру на 4 цифры внизу таблички";
    }

  }catch(e){
    console.error("Digit scanner error:",e);
    status.textContent="Не удалось распознать цифры — попробуйте ещё раз";
  }finally{
    scannerBusy=false;
  }
}


</script>
<script>
let currentChat = "7000";

function nowText() {
  const d = new Date();
  const day = String(d.getDate()).padStart(2,'0');
  const month = String(d.getMonth()+1).padStart(2,'0');
  const year = d.getFullYear();
  const hours = String(d.getHours()).padStart(2,'0');
  const mins = String(d.getMinutes()).padStart(2,'0');
  return {
    date: `${day}.${month}.${year}`,
    time: `${hours}:${mins}`
  };
}

function openChat(name) {
  currentChat = name;
  document.getElementById("home").classList.add("hidden");
  document.getElementById("chat").classList.remove("hidden");
  document.getElementById("chatName").innerHTML = `${name} <span>›</span>`;
  document.getElementById("messages").innerHTML = "";
  document.getElementById("codeInput").value = "";
  validateInput();
}

function goHome() {
  document.getElementById("chat").classList.add("hidden");
  document.getElementById("home").classList.remove("hidden");
}

function formatTime() {
  const d = new Date();
  return d.toLocaleTimeString([], {hour:"2-digit", minute:"2-digit", hour12:false});
}

function validateInput() {
  const input = document.getElementById("codeInput");
  input.value = input.value.replace(/\D/g, "").slice(0,4);
  const sendBtn = document.getElementById("sendBtn");
  const micIcon = document.getElementById("micIcon");
  const sendIcon = document.getElementById("sendIcon");
  const hasCompleteCode = input.value.length === 4;

  sendBtn.classList.toggle("active", hasCompleteCode);
  micIcon.classList.toggle("hidden", hasCompleteCode);
  sendIcon.classList.toggle("hidden", !hasCompleteCode);
  sendBtn.setAttribute("aria-label", hasCompleteCode ? "Отправить" : "Микрофон");
}

function handleComposerAction() {
  const input = document.getElementById("codeInput");
  if (input.value.length === 4) {
    sendCode();
  } else {
    input.focus();
  }
}

function sendCode() {
  const input = document.getElementById("codeInput");
  const code = input.value;
  if (!/^\d{4}$/.test(code)) return;

  const messages = document.getElementById("messages");

  // Фиксируем день недели и время именно в момент отправки.
  const sent = new Date();
  const sentDay = sent.toLocaleDateString("en-US", { weekday:"long" });
  const sentTime = sent.toLocaleTimeString([], { hour:"2-digit", minute:"2-digit", hour12:false });

  const timestamp = document.createElement("div");
  timestamp.className = "message-time message-enter";
  timestamp.textContent = `${sentDay} ${sentTime}`;
  messages.appendChild(timestamp);

  const outgoing = document.createElement("div");
  outgoing.className = "row out message-enter";
  outgoing.innerHTML = `<div class="bubble">${code}</div>`;
  messages.appendChild(outgoing);

  input.value = "";
  validateInput();

  // Плавно показываем входящее сообщение, как новое сообщение в iMessage.
  requestAnimationFrame(() => {
    messages.scrollTo({ top: messages.scrollHeight, behavior: "smooth" });
  });

  setTimeout(() => {
    messages.appendChild(pending);
    messages.scrollTo({ top: messages.scrollHeight, behavior: "smooth" });
  }, 180);

  const reply = document.createElement("div");
  reply.className = "row in message-enter";

  setTimeout(() => {
    // Формируем номер билета и дату/время именно в момент появления входящего сообщения.
    const t = nowText();
    const ticket = String(Math.floor(100000000 + Math.random() * 900000000)).padStart(9, "0");

    reply.innerHTML = `
      <div class="bubble demo">
IM PUA

Bilet Nr MCA-${ticket}

${t.date} ${t.time}

Pret 7 MDL

Bord ${code}
      </div>`;

    messages.appendChild(reply);
    messages.scrollTo({ top: messages.scrollHeight, behavior: "smooth" });
  }, 360);
}
</script>
