<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Messages — iPhone Demo</title>
<style>
* { box-sizing: border-box; }
html, body { margin:0; min-height:100%; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",Arial,sans-serif; }
body { background:#000; color:#fff; }
button, input { font:inherit; }

.app {
  width:100%;
  max-width:520px;
  height:100dvh;
  min-height:100dvh;
  margin:0 auto;
  background:#000;
  position:relative;
  overflow:hidden;
}

.screen { min-height:100vh; }
.hidden { display:none !important; }

/* Home */
.home-header {
  padding:54px 20px 14px;
  font-size:34px;
  font-weight:700;
  border-bottom:1px solid #222;
}
.contact {
  display:flex;
  align-items:center;
  gap:13px;
  padding:14px 18px;
  border-bottom:1px solid #222;
  cursor:pointer;
}
.avatar {
  width:50px; height:50px; border-radius:50%;
  background:linear-gradient(#c9c9cf,#77777f);
  display:grid; place-items:center;
  flex:0 0 auto;
}
.avatar svg { width:30px; height:30px; fill:#eee; }
/* Main menu: no contact/avatar icons — keep only the 7000/7001 rows */
.contact .avatar, .contact img, .contact svg { display:none !important; }
.contact { gap:0; }

.contact-info { flex:1; min-width:0; }
.contact-name { font-size:18px; font-weight:600; }
.contact-sub { color:#8e8e93; font-size:14px; margin-top:3px; }
.chevron { color:#777; font-size:28px; }

/* Chat */
.chat {
  display:flex;
  flex-direction:column;
  height:100vh;
  min-height:100vh;
  background:#000;
  overflow:hidden;
}
.chat-top {
  min-height:142px;
  padding:20px 20px 12px;
  position:relative;
  display:flex;
  align-items:flex-start;
  justify-content:center;
  border-bottom:0;
  background:#000;
  backdrop-filter:none;
}
.back {
  position:absolute;
  left:16px;
  top:20px;
  height:52px;
  width:100px;
  min-width:100px;
  padding:0 10px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:5px;
  color:#fff;
  border:1px solid rgba(255,255,255,.16);
  border-radius:30px;
  background:rgba(45,45,48,.9);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.05);
  cursor:pointer;
}
.back-arrow {
  font-size:30px;
  line-height:1;
  font-weight:300;
  transform:translateY(-2px);
}
.back-number {
  width:54px;
  height:38px;
  border-radius:19px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f4f4f5;
  color:#161616;
  font-size:20px;
  font-weight:400;
}
.profile {
  text-align:center;
  display:flex;
  flex-direction:column;
  align-items:center;
}
.profile .avatar { width:58px; height:58px; margin:0 auto 6px; }
.profile .avatar img { width:100%; height:100%; object-fit:cover; border-radius:50%; display:block; }
.profile-name {
  min-width:118px;
  height:48px;
  padding:0 12px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  border:1px solid rgba(255,255,255,.18);
  border-radius:24px;
  background:rgba(35,35,37,.96);
  color:#fff;
  font-weight:700;
  font-size:20px;
  line-height:1;
}
.profile-name span {
  color:#9b9b9f;
  font-weight:400;
  font-size:28px;
  line-height:.7;
  transform:translateY(-1px);
}

.messages {
  flex:1 1 auto;
  min-height:0;
  /* Дополнительное место снизу, чтобы последнее сообщение не попадало под поднятую строку ввода. */
  padding:16px 14px 56px;
  overflow-y:auto;
  overscroll-behavior:contain;
  background:#000;
  display:flex;
  flex-direction:column;
  gap:8px;
}
.date {
  text-align:center;
  color:#b0b0b5;
  font-size:14px;
  margin:10px 0 12px;
}
.message-time {
  text-align:center;
  color:#b0b0b5;
  font-size:14px;
  font-weight:500;
  line-height:1;
  margin:14px 0 8px;
}
@keyframes messagePopIn {
  0% {
    opacity: 0;
    transform: translateY(10px) scale(.96);
  }
  55% {
    opacity: 1;
    transform: translateY(-1px) scale(1.01);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes timestampFadeIn {
  from { opacity:0; transform:translateY(5px); }
  to   { opacity:1; transform:translateY(0); }
}

.row { display:flex; }
.row.out { justify-content:flex-end; }
.row.in { justify-content:flex-start; }

.row.message-enter {
  animation: messagePopIn .28s cubic-bezier(.22, .61, .36, 1) both;
  transform-origin: bottom;
}

.message-time.message-enter {
  animation: timestampFadeIn .22s ease-out both;
}

@media (prefers-reduced-motion: reduce) {
  .row.message-enter,
  .message-time.message-enter {
    animation:none;
  }
}
/* iMessage-style bubbles */
.bubble {
  position:relative;
  max-width:78%;
  padding:12px 16px;
  border-radius:22px;
  font-size:18px;
  line-height:1.24;
  white-space:pre-line;
  letter-spacing:-.15px;
  box-shadow:none;
}
.out .bubble {
  background:#32d74b;
  color:#fff;
  border-bottom-right-radius:8px;
}
.out .bubble::after {
  content:"";
  position:absolute;
  right:-5px;
  bottom:1px;
  width:18px;
  height:18px;
  background:#32d74b;
  border-bottom-left-radius:14px;
  clip-path:polygon(0 0,100% 100%,0 100%);
}
.in .bubble {
  background:#2c2c2e;
  color:#fff;
  border-bottom-left-radius:8px;
}
.in .bubble::after {
  content:"";
  position:absolute;
  left:-5px;
  bottom:1px;
  width:18px;
  height:18px;
  background:#2c2c2e;
  border-bottom-right-radius:14px;
  clip-path:polygon(0 100%,100% 0,100% 100%);
}
.in .bubble.demo {
  position:relative;
}
.demo-label {
  display:block;
  font-size:11px;
  letter-spacing:.5px;
  color:#ffd60a;
  margin-bottom:5px;
  font-weight:700;
}
.ticket-link {
  color:#58b8ff;
  text-decoration:underline;
}
.composer {
  flex:0 0 auto;
  position:relative;
  bottom:30px;
  min-height:72px;
  padding:10px 12px calc(10px + env(safe-area-inset-bottom));
  display:flex;
  align-items:center;
  gap:10px;
  border-top:1px solid #222;
  background:#000;
}
.add-btn {
  width:52px;
  height:52px;
  flex:0 0 52px;
  border:0;
  border-radius:50%;
  background:#2c2c2f;
  color:#f2f2f7;
  font-size:40px;
  font-weight:300;
  line-height:48px;
  display:grid;
  place-items:center;
  padding:0 0 4px;
  cursor:pointer;
}
.input-wrap {
  flex:1;
  min-width:0;
  height:52px;
  border:1px solid #3a3a3e;
  border-radius:27px;
  display:flex;
  align-items:center;
  padding:0 8px 0 17px;
  background:#000;
  transition:border-color .15s ease, box-shadow .15s ease;
}
.input-wrap:focus-within {
  border-color:#55555a;
  box-shadow:0 0 0 1px rgba(255,255,255,.02);
}
.input-wrap input {
  min-width:0;
  flex:1;
  height:100%;
  border:0;
  outline:0;
  background:transparent;
  color:#fff;
  font-size:20px;
  font-weight:400;
  letter-spacing:-.2px;
}
.input-wrap input::placeholder { color:#8e8e93; opacity:1; }
.mic-btn {
  width:42px;
  height:42px;
  flex:0 0 42px;
  margin-left:3px;
  border:0;
  border-radius:50%;
  background:transparent;
  color:#a1a1a6;
  display:grid;
  place-items:center;
  padding:0;
  cursor:pointer;
}
.mic-icon {
  width:29px;
  height:29px;
  fill:none;
  stroke:currentColor;
  stroke-width:2.1;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.mic-btn.active {
  color:#fff;
  background:#7ee000;
  box-shadow:0 0 0 1px rgba(126,224,0,.15);
}
.send-icon { width:29px; height:29px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }

.notice {
  margin:12px 14px 0;
  padding:8px 12px;
  border:1px solid #3a3a3c;
  border-radius:10px;
  color:#8e8e93;
  font-size:12px;
  text-align:center;
}

/* Scanner — clean camera UI */
.scan-launch{
  width:52px;height:52px;flex:0 0 52px;border:0;border-radius:50%;
  background:#2c2c2f;color:#fff;display:grid;place-items:center;padding:0;cursor:pointer;
}
.scan-launch svg{width:27px;height:27px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}

.scanner{
  position:fixed;inset:0;z-index:9999;display:none;overflow:hidden;
  background:#000;color:#fff;
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",Arial,sans-serif;
}
.scanner.open{display:block}
.scanner video{
  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#000;
}
.scanner-shade{
  position:absolute;inset:0;z-index:1;pointer-events:none;
  background:linear-gradient(
    to bottom,
    #000 0%,#000 13.85%,
    rgba(0,0,0,0) 13.85%,rgba(0,0,0,0) 75.25%,
    rgba(0,0,0,.35) 75.25%,#000 82.5%,#000 100%
  );
}

/* supplied image modules */
.camera-module{position:absolute;z-index:8;pointer-events:none}
.camera-module img{display:block;width:100%;height:100%;object-fit:fill}
.camera-heif{left:24px;top:8.45%;width:94px;height:60px}
.camera-controls{right:24px;top:8.45%;width:158px;height:54px}

/* Scanner detection target is kept for functionality, but hidden to match the reference UI. */
.scan-frame,.scan-instruction{display:none}
.scan-status{position:absolute;opacity:0;pointer-events:none}
.scan-result{
  position:absolute;left:50%;top:58%;transform:translate(-50%,-50%);z-index:20;
  min-width:104px;padding:8px 15px;border-radius:18px;
  background:rgba(30,30,32,.82);font-size:22px;font-weight:600;
  text-align:center;opacity:0;transition:.2s;pointer-events:none;
}
.scan-result.show{opacity:1}

/* bottom camera controls */
.scan-bottom{
  position:absolute;left:0;right:0;bottom:0;height:25%;
  z-index:7;pointer-events:none;
  background:linear-gradient(to bottom,rgba(0,0,0,0) 0%,rgba(0,0,0,.72) 23%,#000 47%,#000 100%);
}

.camera-zoom{
  position:absolute;left:50%;bottom:calc(100% + 17px);
  transform:translateX(-50%);
  display:flex;align-items:center;justify-content:center;gap:19px;
  width:180px;height:48px;color:#fff;font-size:17px;font-weight:500;
  text-shadow:0 1px 4px #000;
}
.camera-zoom b{
  width:48px;height:48px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:#2e2e30;color:#ffd60a;font-weight:600;
}

.scan-shutter{
  position:absolute;left:50%;top:26px;
  transform:translateX(-50%);
  width:120px;height:120px;padding:0;border:0;
  background:transparent;pointer-events:auto;cursor:pointer;
}
.scan-shutter img{display:block;width:100%;height:100%;object-fit:fill}

.camera-gallery{
  position:absolute;left:51px;bottom:50px;
  width:72px;height:72px;border-radius:50%;overflow:hidden;
  background:linear-gradient(145deg,#111 0%,#6f6f6f 48%,#252525 49%,#111 100%);
  border:1px solid rgba(255,255,255,.12);
}
.camera-gallery::after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(145deg,transparent 44%,rgba(255,255,255,.25) 45% 49%,transparent 50%);
}

.scan-flip{
  position:absolute;right:50px;bottom:49px;
  width:72px;height:76px;padding:0;border:0;background:transparent;
  pointer-events:auto;cursor:pointer;
}
.scan-flip img{display:block;width:100%;height:100%;object-fit:fill}

.camera-modes{
  position:absolute;left:50%;bottom:47px;
  transform:translateX(-50%);width:235px;height:77px;
}
.camera-modes img{display:block;width:100%;height:100%;object-fit:fill}

.camera-homebar{
  position:absolute;left:50%;bottom:9px;transform:translateX(-50%);
  width:200px;height:5px;border-radius:5px;background:#fff;
}
.scanner-close-hit{
  position:absolute;left:0;top:0;width:70px;height:70px;z-index:30;
  opacity:0;border:0;background:transparent;pointer-events:auto;
}

@media (min-width:700px){
  .scanner{
    max-width:590px;left:50%;right:auto;width:590px;transform:translateX(-50%);
  }
}


